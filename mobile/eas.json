{
  "cli": { "version": ">= 18.0.0", "appVersionSource": "remote" },
  "build": {
    "preview": {
      "distribution": "internal",
      "environment": "preview",
      "autoIncrement": true,
      "env": {
        "APP_VARIANT": "release",
        "EXPO_PUBLIC_API_TIMEOUT_MS": "90000"
      },
      "android": { "buildType": "apk" }
    },
    "production": {
      "environment": "production",
      "autoIncrement": true,
      "env": {
        "APP_VARIANT": "release",
        "EXPO_PUBLIC_API_TIMEOUT_MS": "90000"
      },
      "android": { "buildType": "app-bundle" }
    }
  }
}
