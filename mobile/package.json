{
  "name": "fitness-tracker-mobile",
  "version": "0.1.0",
  "main": "index.ts",
  "dependencies": {
    "@expo/vector-icons": "^15.0.2",
    "@react-navigation/bottom-tabs": "^7.18.18",
    "@react-navigation/native": "^7.3.18",
    "@react-navigation/native-stack": "^7.18.10",
    "expo": "~57.0.22",
    "expo-crypto": "~57.0.3",
    "expo-secure-store": "~57.0.4",
    "expo-sqlite": "~57.0.3",
    "expo-status-bar": "~57.0.1",
    "react": "19.2.3",
    "react-native": "0.86.3",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0"
  },
  "devDependencies": {
    "@types/node": "26.5.1",
    "@types/react": "~19.2.2",
    "prettier": "^3.9.6",
    "typescript": "~6.0.3",
    "vitest": "^4.1.11"
  },
  "scripts": {
    "test": "vitest run",
    "format": "prettier --write src App.tsx",
    "api:types": "npm exec --yes --package=typescript@5.9.3 --package=openapi-typescript@7.13.0 -- openapi-typescript ../docs/openapi.json -o src/services/api/schema.d.ts && prettier --write src/services/api/schema.d.ts",
    "typecheck": "tsc --noEmit",
    "release:check": "node scripts/check-release.cjs",
    "eas-build-post-install": "node scripts/check-release.cjs",
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios"
  },
  "private": true
}
