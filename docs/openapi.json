              "title": "Favorites Only"
            }
          },
          {
            "name": "custom_only",
            "in": "query",
            "required": false,
            "schema": {
              "type": "boolean",
              "default": false,
              "title": "Custom Only"
            }
          },
          {
            "name": "cursor",
